rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // ==================== HELPER FUNCTIONS ====================
    
    // Check if current user is admin
    function isAdmin() {
      return request.auth != null && 
             request.auth.token.email == 'oussamaanis2005@gmail.com';
    }
    
    // Check if current user is staff with role A
    function isStaffA() {
      let staffDoc = get(/databases/$(database)/documents/staff/$(request.auth.uid));
      return request.auth != null &&
             staffDoc.data.role == 'Staff A' &&
             staffDoc.data.email == request.auth.token.email;
    }
    
    // Check if current user is staff with role B
    function isStaffB() {
      let staffDoc = get(/databases/$(database)/documents/staff/$(request.auth.uid));
      return request.auth != null &&
             staffDoc.data.role == 'Staff B' &&
             staffDoc.data.email == request.auth.token.email;
    }
    
    // ==================== MENU COLLECTION ====================
    match /menu/{menuId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }
    
    // ==================== CATEGORIES COLLECTION ====================
    match /categories/{categoryId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }
    
    // ==================== ORDERS COLLECTION ====================
    match /orders/{orderId} {
      allow create: if true;
      
      allow read: if isAdmin() || isStaffB() ||
                     (request.auth != null && request.auth.token.email == resource.data.email) ||
                     (request.auth != null && request.auth.uid == resource.data.userId);
      
      allow update: if isAdmin() || 
                       (isStaffB() && request.resource.data.status != null && 
                        request.resource.data.keys().size() <= 2);
      
      allow delete: if isAdmin();
    }
    
    // ==================== SETTINGS COLLECTION ====================
    match /settings/{settingId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }
    
    // ==================== REVIEWS/FEEDBACK COLLECTION ====================
    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if isAdmin();
    }
    
    // ==================== CONTACT MESSAGES COLLECTION ====================
    match /contact_messages/{messageId} {
      allow read: if isAdmin() || isStaffA();
      allow create: if true;
      allow delete: if isAdmin();
    }
    
    // ==================== STAFF COLLECTION ====================
    match /staff/{staffId} {
      allow read: if isAdmin();
      allow create, update, delete: if isAdmin();
    }
  }
}
