rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // ==================== HELPER FUNCTIONS ====================
    
    // Check if current user is admin
    function isAdmin() {
      return request.auth != null && 
             request.auth.token.email == 'oussamaanis2005@gmail.com';
    }
    
    // Helper to find staff by normalized email
    function getStaffByEmail(email) {
      return get(/databases/$(database)/documents/staff/$(request.auth.uid)).data;
    }
    
    // Check if current user is staff with role A (view orders & messages)
    function isStaffA() {
      return request.auth != null &&
             exists(/databases/$(database)/documents/staff/$(request.auth.uid)) &&
             get(/databases/$(database)/documents/staff/$(request.auth.uid)).data.role == 'Staff A' &&
             get(/databases/$(database)/documents/staff/$(request.auth.uid)).data.email.lower() == request.auth.token.email.lower();
    }
    
    // Check if current user is staff with role B (manage messages & reviews)
    function isStaffB() {
      return request.auth != null &&
             exists(/databases/$(database)/documents/staff/$(request.auth.uid)) &&
             get(/databases/$(database)/documents/staff/$(request.auth.uid)).data.role == 'Staff B' &&
             get(/databases/$(database)/documents/staff/$(request.auth.uid)).data.email.lower() == request.auth.token.email.lower();
    }
    
    // Check if staff document exists for this user's email
    function isStaffByEmail() {
      let staff = get(/databases/$(database)/documents/staff/$(request.auth.uid));
      return request.auth != null &&
             staff.data.email.lower() == request.auth.token.email.lower();
    }
    
    // ==================== MENU COLLECTION ====================
    match /menu/{menuId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }
    
    // ==================== CATEGORIES COLLECTION ====================
    match /categories/{categoryId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }
    
    // ==================== ORDERS COLLECTION ====================
    match /orders/{orderId} {
      allow create: if true;
      
      // Admin: full read access
      // Staff A: read-only access to view orders
      // Staff B: read/update access to manage orders
      // Customers: read own orders by email or userId
      allow read: if isAdmin() || 
                     isStaffA() || 
                     isStaffB() ||
                     (request.auth != null && request.auth.token.email.lower() == resource.data.email.lower()) ||
                     (request.auth != null && request.auth.uid == resource.data.userId);
      
      // Only Admin and Staff B can update order status
      allow update: if isAdmin() || 
                       (isStaffB() && request.resource.data.status != null && 
                        request.resource.data.keys().size() <= 2);
      
      allow delete: if isAdmin();
    }
    
    // ==================== SETTINGS COLLECTION ====================
    match /settings/{settingId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }
    
    // ==================== REVIEWS/FEEDBACK COLLECTION ====================
    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if true;
      
      // Admin: full access
      // Staff B: can read and edit/delete reviews
      allow update, delete: if isAdmin() || isStaffB();
    }
    
    // ==================== CONTACT MESSAGES COLLECTION ====================
    match /contact_messages/{messageId} {
      allow read: if isAdmin() || isStaffA() || isStaffB();
      allow create: if true;
      
      // Admin: full access
      // Staff B: can edit and delete messages
      allow update, delete: if isAdmin() || isStaffB();
    }
    
    // ==================== STAFF COLLECTION ====================
    match /staff/{staffId} {
      allow read: if isAdmin();
      allow create, update, delete: if isAdmin();
    }
  }
}
