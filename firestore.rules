
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // ==================== HELPER FUNCTIONS ====================
    
    // Check if current user is admin
    function isAdmin() {
      return request.auth != null && 
             request.auth.token.email == 'oussamaanis2005@gmail.com';
    }
    
    // Check if current user is staff with role A (can read messages and reviews)
    function isStaffA() {
      return request.auth != null &&
             exists(/databases/{database}/documents/staff/{request.auth.uid}) &&
             get(/databases/{database}/documents/staff/{request.auth.uid}).data.role == 'Staff A' &&
             get(/databases/{database}/documents/staff/{request.auth.uid}).data.email == request.auth.token.email;
    }
    
    // Check if current user is staff with role B (can manage orders by status)
    function isStaffB() {
      return request.auth != null &&
             exists(/databases/{database}/documents/staff/{request.auth.uid}) &&
             get(/databases/{database}/documents/staff/{request.auth.uid}).data.role == 'Staff B' &&
             get(/databases/{database}/documents/staff/{request.auth.uid}).data.email == request.auth.token.email;
    }
    
    // ==================== MENU COLLECTION ====================
    match /menu/{menuId} {
      allow read: if true;  // Public can view menu
      allow create, update, delete: if isAdmin();  // Only admin can modify menu
    }
    
    // ==================== CATEGORIES COLLECTION ====================
    match /categories/{categoryId} {
      allow read: if true;  // Public can view categories
      allow create, update, delete: if isAdmin();  // Only admin can modify categories
    }
    
    // ==================== ORDERS COLLECTION ====================
    match /orders/{orderId} {
      // Anyone can create an order
      allow create: if true;
      
      // Users read own orders; admin reads all; Staff B reads all
      allow read: if isAdmin() || isStaffB() ||
                     (request.auth != null && request.auth.token.email == resource.data.email) ||
                     (request.auth != null && request.auth.uid == resource.data.userId);
      
      // Admin can update/delete; Staff B can only update order status (no delete)
      allow update: if isAdmin() || (isStaffB() && request.resource.data.keys().hasOnly(['status', 'updatedAt']));
      allow delete: if isAdmin();
    }
    
    // ==================== SETTINGS COLLECTION ====================
    // Used by: loadSettingsData(), updateSettings(), getSettings()
    // Firebase functions: dbService.getSettings(), dbService.updateSettings()
    // Document ID: 'restaurant' contains business info (name, phone, address, hours, payment methods)
    match /settings/{settingId} {
      allow read: if true;  // Public can view settings (business hours, info)
      allow create, update, delete: if isAdmin();  // Only admin can modify settings
    }
    
    // ==================== REVIEWS/FEEDBACK COLLECTION ====================
    // Used by: submitFeedback(), renderFeedbackList(), populateFeedbackItems()
    // Firebase functions: dbService.addReview(), dbService.getAllReviews(),
    //                     dbService.deleteReview()
    match /reviews/{reviewId} {
      allow read: if true;  // Public can read all reviews
      allow create: if true;  // Anyone can submit reviews (customers + guests)
      allow update, delete: if isAdmin();  // Only admin can modify/delete reviews
    }
    
    // ==================== CONTACT MESSAGES COLLECTION ====================
    // Used by: submitContact(), loadMessages(), deleteMessage()
    // Firebase functions: dbService.addContactMessage(), dbService.getAllContactMessages(),
    //                     dbService.deleteContactMessage()
    match /contact_messages/{messageId} {
      allow read: if isAdmin();  // Only admin can read messages
      allow create: if true;  // Anyone can submit contact messages (customers + guests)
      allow delete: if isAdmin();  // Only admin can delete messages
    }
  }
}
