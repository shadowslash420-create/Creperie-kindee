rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Allow all users to read menu and categories
    match /menu/{menuId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /categories/{categoryId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Allow anyone to create orders (for guest checkout)
    // But only authenticated users can read their own orders
    match /orders/{orderId} {
      allow create: if true;
      allow read: if request.auth != null &&
                     (request.auth.token.email in resource.data.email ||
                      request.auth.uid == resource.data.userId);
      allow update, delete: if request.auth != null;
    }

    // Admin-only access to all orders
    match /orders/{orderId} {
      allow read, write: if request.auth != null &&
                            request.auth.token.email == 'oussamaanis2005@gmail.com';
    }
  }
}