rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // ==================== HELPER FUNCTIONS ====================
    
    // Check if current user is admin
    function isAdmin() {
      return request.auth != null && 
             request.auth.token.email == 'oussamaanis2005@gmail.com';
    }
    
    // ==================== MENU COLLECTION ====================
    match /menu/{menuId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }
    
    // ==================== CATEGORIES COLLECTION ====================
    match /categories/{categoryId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }
    
    // ==================== ORDERS COLLECTION ====================
    match /orders/{orderId} {
      allow create: if request.auth != null; // Customers must be logged in
      
      // Admin: full read access
      // Customers: read own orders by email match
      allow read: if isAdmin() || 
                     (request.auth != null && request.auth.token.email == resource.data.email) ||
                     (request.auth != null && request.auth.uid == resource.data.userId);
      
      // Admin and authenticated users can update order status
      allow update: if isAdmin() || request.auth != null;
      
      allow delete: if isAdmin();
    }
    
    // ==================== SETTINGS COLLECTION ====================
    match /settings/{settingId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }
    
    // ==================== REVIEWS/FEEDBACK COLLECTION ====================
    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if request.auth != null; // Customers must be logged in
      
      // Admin: full access
      // Authenticated users can update/delete reviews
      allow update, delete: if isAdmin() || request.auth != null;
    }
    
    // ==================== CONTACT MESSAGES COLLECTION ====================
    match /contact_messages/{messageId} {
      allow read: if request.auth != null; // Any authenticated user can read
      allow create: if true; // Anyone can submit contact message
      
      // Admin and authenticated users can manage messages
      allow update, delete: if isAdmin() || request.auth != null;
    }
    
    // ==================== STAFF COLLECTION ====================
    match /staff/{staffId} {
      allow read: if true; // Allow reading staff for login/role checking
      allow create, update, delete: if isAdmin();
    }
  }
}
