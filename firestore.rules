rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // ==================== HELPER FUNCTIONS ====================
    
    // Check if current user is admin
    function isAdmin() {
      return request.auth != null && 
             request.auth.token.email == 'oussamaanis2005@gmail.com';
    }
    
    // Check if current user is staff with role A (view orders & messages, update order status)
    function isStaffA() {
      return request.auth != null &&
             exists(/databases/$(database)/documents/staff/$(request.auth.uid)) &&
             get(/databases/$(database)/documents/staff/$(request.auth.uid)).data.role == 'Staff A' &&
             get(/databases/$(database)/documents/staff/$(request.auth.uid)).data.email.lower() == request.auth.token.email.lower();
    }
    
    // Check if current user is staff with role B (manage messages & reviews only)
    function isStaffB() {
      return request.auth != null &&
             exists(/databases/$(database)/documents/staff/$(request.auth.uid)) &&
             get(/databases/$(database)/documents/staff/$(request.auth.uid)).data.role == 'Staff B' &&
             get(/databases/$(database)/documents/staff/$(request.auth.uid)).data.email.lower() == request.auth.token.email.lower();
    }
    
    // ==================== MENU COLLECTION ====================
    match /menu/{menuId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }
    
    // ==================== CATEGORIES COLLECTION ====================
    match /categories/{categoryId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }
    
    // ==================== ORDERS COLLECTION ====================
    match /orders/{orderId} {
      allow create: if request.auth != null; // Customers must be logged in
      
      // Admin: full read access
      // Staff A: read-only access to view orders
      // Customers: read own orders by email or userId
      allow read: if isAdmin() || 
                     isStaffA() ||
                     (request.auth != null && request.auth.token.email.lower() == resource.data.email.lower()) ||
                     (request.auth != null && request.auth.uid == resource.data.userId);
      
      // Admin and Staff A can update order status
      allow update: if isAdmin() || 
                       (isStaffA() && request.resource.data.status != null && 
                        request.resource.data.keys().size() <= 2);
      
      allow delete: if isAdmin();
    }
    
    // ==================== SETTINGS COLLECTION ====================
    match /settings/{settingId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }
    
    // ==================== REVIEWS/FEEDBACK COLLECTION ====================
    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if request.auth != null; // Customers must be logged in
      
      // Admin: full access
      // Staff B: can approve/delete reviews (update/delete)
      allow update, delete: if isAdmin() || isStaffB();
    }
    
    // ==================== CONTACT MESSAGES COLLECTION ====================
    match /contact_messages/{messageId} {
      allow read: if isAdmin() || isStaffA() || isStaffB();
      allow create: if request.auth != null; // Customers must be logged in
      
      // Admin: full access
      // Staff B: can approve/delete messages (update/delete)
      allow update, delete: if isAdmin() || isStaffB();
    }
    
    // ==================== STAFF COLLECTION ====================
    match /staff/{staffId} {
      allow read: if isAdmin();
      allow create, update, delete: if isAdmin();
    }
  }
}
