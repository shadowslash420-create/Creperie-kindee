
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check if user is admin
    function isAdmin() {
      return request.auth != null && 
             request.auth.token.email == 'oussamaanis2005@gmail.com';
    }
    
    // Menu items - public read, admin write
    match /menu/{menuId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }
    
    // Categories - public read, admin write
    match /categories/{categoryId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }
    
    // Orders - clients can create and read their own, admin can do everything
    match /orders/{orderId} {
      // Anyone can create an order (guest checkout)
      allow create: if true;
      
      // Users can read their own orders by email or phone
      allow read: if isAdmin() || 
                     (request.auth != null && request.auth.token.email == resource.data.email) ||
                     (request.auth != null && request.auth.uid == resource.data.userId);
      
      // Only admin can update or delete orders
      allow update, delete: if isAdmin();
    }
  }
}
